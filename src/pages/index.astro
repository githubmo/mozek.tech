---
import Layout from "../layouts/Layout.astro";
import WorkLog from "../components/WorkLog.astro";
import TechLogos from "../components/TechLogos.astro";
import CTA from "../components/CTA.astro";

const principles = [
  { title: "Outcome-driven", desc: "Every engagement starts from the business result you need." },
  { title: "Production-grade", desc: "Architecturally sound systems built to run, not just to demo." },
  { title: "Senior & hands-on", desc: "You work directly with the engineers doing the work." },
];

const services = [
  { title: "Consulting", desc: "End-to-end data strategy and hands-on engineering to accelerate your cloud and data initiatives." },
  { title: "Training", desc: "Expert-led programmes that upskill your engineering teams in modern cloud, data and AI technologies." },
  { title: "Architecture review", desc: "Independent assessment of your existing systems to close gaps, cut cost and improve resilience." },
  { title: "Cloud-native solutions", desc: "Bespoke cloud-native development, from IoT ingestion to real-time analytics and ML-powered products." },
];

const testimonials = [
  {
    logo: "/logos/brighthouse.svg",
    company: "Brighthouse Financial",
    quote:
      "We first worked with them on an innovative hedging platform, where they helped us design and implement key data acquisition and management services. The engagement was so successful that we brought them back to help us analyze our data architecture and build a new event-driven data management platform. They work effectively with both our technology teams and our business partners, and they consistently deliver top-level implementations. I would absolutely work with them again.",
    name: "Craig Stewart",
    role: "Leader, DevOps & Managed Services",
    org: "Brighthouse Financial, Inc.",
  },
  {
    logo: "/logos/depop.svg",
    company: "Depop",
    quote:
      "Mozek Technologies has worked with Depop’s Ranking team since June 2026, supporting our machine learning data pipelines and model-serving infrastructure. Our data-generation jobs now run four to five times faster on average, while model-training jobs run up to twice as fast. These improvements have resolved several persistent pain points and materially improved the team’s day-to-day efficiency. Working with Mozek Technologies has been an excellent contractor experience, and we would be very happy to work with them again.",
    name: "Guilhem Vuillier",
    role: "Senior ML Manager",
    org: "Depop, an eBay company",
  },
];
---

<Layout title="Mozek Technologies — Data, Cloud & AI Engineering">
  <!-- ══════════ HERO ══════════ -->
  <section class="relative overflow-hidden px-6 pb-20 pt-16 lg:pb-28 lg:pt-24">
    <div
      class="bg-dotgrid pointer-events-none absolute inset-0"
      style="-webkit-mask-image:radial-gradient(ellipse 80% 70% at 30% 25%,#000 0%,transparent 75%);mask-image:radial-gradient(ellipse 80% 70% at 30% 25%,#000 0%,transparent 75%);"
    >
    </div>
    <div class="relative mx-auto grid max-w-7xl items-center gap-x-16 gap-y-12 lg:grid-cols-[1.1fr_1fr]">
      <div>
        <h1 class="max-w-3xl font-heading text-5xl font-bold leading-[1.02] text-ink-50 lg:text-7xl">
          Data &amp; AI infrastructure that holds up in production.
        </h1>
        <p class="mt-7 max-w-xl text-lg leading-relaxed text-ink-300 lg:text-xl">
          We're a small team of senior engineers working on cloud platforms,
          data engineering, machine learning and AI. The people you meet on the
          first call are the people who write the code.
        </p>
        <div class="mt-9 flex flex-wrap gap-3.5">
          <a href="/contact" class="inline-flex items-center rounded-lg bg-primary px-6 py-3.5 font-semibold text-primary-content transition-colors hover:bg-secondary">
            Book a consultation
          </a>
          <a href="/case-studies" class="inline-flex items-center rounded-lg border border-ink-600 px-6 py-3.5 font-medium text-ink-50 transition-colors hover:border-primary hover:text-primary">
            Read the case studies
          </a>
        </div>
      </div>

      <WorkLog />
    </div>
  </section>

  <!-- ══════════ TECH LOGOS ══════════ -->
  <TechLogos />

  <!-- ══════════ APPROACH ══════════ -->
  <section class="mx-auto grid max-w-7xl gap-x-20 gap-y-12 px-6 py-20 lg:grid-cols-2 lg:py-28">
    <div>
      <h2 class="font-heading text-3xl font-bold leading-tight text-ink-50 lg:text-5xl">
        We start with your business outcomes, not the tech stack.
      </h2>
      <p class="mt-6 max-w-xl leading-relaxed text-ink-300">
        Whatever the size of your systems, we begin by understanding the result
        you need. Then we bring the engineering to get there: architecturally
        sound, pragmatic, and built to keep running after we leave.
      </p>
    </div>
    <dl class="self-center">
      {
        principles.map((p) => (
          <div class="border-t border-ink-700/60 py-5 last:border-b">
            <dt class="font-heading text-xl font-semibold text-ink-50">{p.title}</dt>
            <dd class="mt-1.5 text-ink-300">{p.desc}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- ══════════ SERVICES ══════════ -->
  <section class="mx-auto max-w-7xl px-6 pb-20 lg:pb-28">
    <h2 class="font-heading text-3xl font-bold leading-tight text-ink-50 lg:text-5xl">Four ways we plug in.</h2>
    <ul class="mt-10 grid gap-x-12 sm:grid-cols-2">
      {
        services.map((s) => (
          <li class="border-t border-ink-700/60 py-7">
            <h3 class="font-heading text-2xl font-semibold text-ink-50">{s.title}</h3>
            <p class="mt-2.5 max-w-md leading-relaxed text-ink-300">{s.desc}</p>
          </li>
        ))
      }
    </ul>
    <a href="/services" class="mt-4 inline-block font-semibold text-primary underline decoration-primary/40 underline-offset-4 hover:decoration-primary">
      What each one includes
    </a>
  </section>

  <!-- ══════════ TESTIMONIALS ══════════ -->
  <section class="mx-auto max-w-7xl px-6 py-20 lg:py-28">
    <h2 class="max-w-2xl font-heading text-3xl font-bold leading-tight text-ink-50 lg:text-5xl">
      Clients bring us back.
    </h2>
    <div class="mt-12 grid gap-x-16 gap-y-14 lg:grid-cols-2">
      {
        testimonials.map((t) => (
          <figure class="flex flex-col border-l-2 border-primary pl-6 lg:pl-8">
            <img src={t.logo} alt={t.company} class="h-7 w-auto self-start opacity-80 brightness-0 invert" loading="lazy" />
            <blockquote class="mt-6 flex-1 text-[1.05rem] leading-relaxed text-ink-100">&ldquo;{t.quote}&rdquo;</blockquote>
            <figcaption class="mt-6">
              <div class="font-heading font-semibold text-ink-50">{t.name}</div>
              <div class="mt-0.5 text-sm text-ink-300">{t.role}, {t.org}</div>
            </figcaption>
          </figure>
        ))
      }
    </div>
    <a href="/case-studies" class="mt-12 inline-block font-semibold text-primary underline decoration-primary/40 underline-offset-4 hover:decoration-primary">
      Read the full case studies
    </a>
  </section>

  <!-- ══════════ CTA ══════════ -->
  <CTA />
</Layout>
